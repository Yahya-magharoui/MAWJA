{
  "name": "@mawja/mobile",
  "private": true,
  "main": "index.js",
  "scripts": {
    "dev": "expo start -c",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "doctor:build": "node ./scripts/doctor-build.mjs",
    "doctor:android-gradle": "node ./scripts/normalize-android-gradle.mjs",
    "eas:build:preview:android": "npx eas-cli build --platform android --profile preview",
    "eas:build:preview:ios": "npx eas-cli build --platform ios --profile preview",
    "eas:build:production:android": "npx eas-cli build --platform android --profile production",
    "eas:build:production:ios": "npx eas-cli build --platform ios --profile production",
    "eas:submit:android": "npx eas-cli submit --platform android --profile production",
    "eas:submit:ios": "npx eas-cli submit --platform ios --profile production"
  },
  "dependencies": {
    "@babel/runtime": "^7.28.4",
    "@expo/metro-runtime": "~3.2.3",
    "expo": "~51.0.39",
    "expo-asset": "~10.0.10",
    "expo-constants": "~16.0.2",
    "expo-dev-client": "~4.0.29",
    "expo-linking": "~6.3.1",
    "expo-modules-core": "~1.12.26",
    "expo-router": "~3.5.24",
    "expo-splash-screen": "~0.27.5",
    "expo-status-bar": "~1.12.1",
    "react": "^18.2.0",
    "react-native": "^0.74.5",
    "react-native-reanimated": "~3.10.1",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "3.31.1",
    "react-native-web": "~0.19.13"
  },
  "devDependencies": {
    "@expo/cli": "0.18.31",
    "@react-native/codegen": "0.74.87",
    "@react-native/gradle-plugin": "0.74.87",
    "@types/react": "^18.2.66"
  }
}
