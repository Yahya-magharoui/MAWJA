# Référence consolidée du monorepo.
# En local, copie les variables web dans apps/web/.env
# et les variables serveur dans server/.env.

# Web (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# API (server)
DATABASE_URL=postgresql://galini:galini@localhost:5432/galini?schema=public
PORT=3000
AUTH_TOKEN_SECRET=replace-with-a-long-random-secret
AUTH_TOKEN_TTL_SECONDS=604800
TRUST_PROXY=false
ALLOWED_ORIGINS=http://localhost:3001
WEB_APP_URL=http://localhost:3001

# Limitation des requêtes
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=30

# Activation du compte par e-mail
EMAIL_VERIFICATION_ENABLED=false
EMAIL_VERIFICATION_EXPIRY_HOURS=24

# Réinitialisation du mot de passe
PASSWORD_RESET_EMAIL_ENABLED=false
PASSWORD_RESET_EXPIRY_HOURS=2

# Nettoyage des demandes temporaires
TEMP_DATA_CLEANUP_INTERVAL_MS=21600000
CONSUMED_TOKEN_RETENTION_HOURS=24

# Resend (serveur uniquement)
RESEND_API_KEY=
RESEND_FROM_EMAIL=no-reply@mail.kalymap.com
