{
  "name": "server",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "nest start --watch",
    "build": "pnpm prisma:generate && nest build",
    "start": "node dist/main.js",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:db:pull": "prisma db pull",
    "prisma:migrate": "node ./scripts/block-legacy-prisma-migrate.cjs",
    "prisma:deploy": "node ./scripts/block-legacy-prisma-migrate.cjs",
    "start:railway": "node dist/main.js",
    "lint": "eslint ."
  },
  "dependencies": {
    "@nestjs/common": "10.3.0",
    "@nestjs/core": "10.3.0",
    "@nestjs/platform-express": "10.3.0",
    "@prisma/client": "5.7.1",
    "bcrypt": "^6.0.0",
    "express": "^5.1.0",
    "prisma": "5.7.1",
    "redis": "^5.8.2",
    "reflect-metadata": "0.1.13",
    "rxjs": "7.8.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@nestjs/cli": "10.3.2",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.3",
    "ts-node": "10.9.2",
    "typescript": "5.4.5"
  }
}
