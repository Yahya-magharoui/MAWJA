# Database
DATABASE_URL=postgresql://galini:galini@localhost:5432/galini?schema=public

# API runtime
PORT=3000
AUTH_TOKEN_SECRET=replace-with-a-long-random-secret
AUTH_TOKEN_TTL_SECONDS=604800
TRUST_PROXY=false

# CORS
# Production: renseigner uniquement des origines HTTPS, séparées par des virgules.
# L'origine de WEB_APP_URL doit aussi être présente dans ALLOWED_ORIGINS.
ALLOWED_ORIGINS=http://localhost:3001

# Rate limiting
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=120
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=30

# Web app URL used in links sent by email
# Production: utiliser l'URL HTTPS publique du front.
WEB_APP_URL=http://localhost:3001

# Email verification
EMAIL_VERIFICATION_ENABLED=false
EMAIL_VERIFICATION_EXPIRY_HOURS=24

# Password reset
PASSWORD_RESET_EMAIL_ENABLED=false
PASSWORD_RESET_EXPIRY_HOURS=2

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
