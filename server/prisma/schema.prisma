generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String      @id @default(cuid())
  email     String      @unique
  createdAt DateTime    @default(now())
  mood      MoodEntry[]
}

model MoodEntry {
  id        String   @id @default(cuid())
  userId    String
  state     String
  value     Int
  context   String?
  timestamp DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id])
}
