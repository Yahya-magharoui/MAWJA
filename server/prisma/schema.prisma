generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// This schema intentionally mirrors the legacy PostgreSQL tables that are
// currently used by the Nest API through raw SQL. Keep it aligned with the
// real database shape before reintroducing Prisma migrations or model-based
// queries.

enum Role {
  PATIENT
  DOCTOR
}

enum HistoryState {
  HYPER
  TOLERANCE
  HYPO
}

enum ActivityCategory {
  EMOTION
  SAFE_PLACE
  AUDIO
  GROUNDING
  SBA
  BREATHING
  TOOL
  HELP
}

model User {
  id               Int       @id @default(autoincrement())
  email            String    @unique
  password         String?
  name             String?
  role             Role      @default(PATIENT)
  createdAt        DateTime  @default(now())
  patientProfileId Int?      @unique
  doctorProfileId  Int?      @unique
  patientProfile   Patient?  @relation("UserPatientProfile", fields: [patientProfileId], references: [id])
  doctorProfile    Doctor?   @relation("UserDoctorProfile", fields: [doctorProfileId], references: [id])
  patientAccount   Patient?  @relation("PatientOwner")
  doctorAccount    Doctor?   @relation("DoctorOwner")
  sessions         AuthSession[]

  @@map("User")
}

model AuthSession {
  id        BigInt    @id @default(autoincrement())
  userId    Int       @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("AuthSession")
}

model Patient {
  id               Int        @id @default(autoincrement())
  userId           Int        @unique
  doctorId         Int?
  currentSituation String?
  createdAt        DateTime   @default(now())
  user             User       @relation("PatientOwner", fields: [userId], references: [id])
  profileOwner     User?      @relation("UserPatientProfile")
  doctor           Doctor?    @relation(fields: [doctorId], references: [id])
  histories        History[]
  goals            Goal[]
  notes            Note[]
  favorites        Favorite[]
  activityLogs     ActivityLog[]

  @@map("Patient")
}

model Doctor {
  id          Int       @id @default(autoincrement())
  userId      Int       @unique
  doctor_code String    @unique
  createdAt   DateTime  @default(now())
  user        User      @relation("DoctorOwner", fields: [userId], references: [id])
  profileOwner User?    @relation("UserDoctorProfile")
  patients    Patient[]

  @@map("Doctor")
}

model History {
  id         Int            @id @default(autoincrement())
  time       DateTime
  state      HistoryState
  patientId  Int
  createdAt  DateTime       @default(now())
  patient    Patient        @relation(fields: [patientId], references: [id])
  activities ActivityLog[]

  @@index([patientId, createdAt])
  @@map("History")
}

model ActivityLog {
  id         Int               @id @default(autoincrement())
  patientId  Int
  historyId  Int?
  category   ActivityCategory
  subType    String
  detail     String?
  emotion    String?
  createdAt  DateTime          @default(now())
  patient    Patient           @relation(fields: [patientId], references: [id])
  history    History?          @relation(fields: [historyId], references: [id])

  @@index([patientId, createdAt])
  @@index([historyId, createdAt])
  @@map("ActivityLog")
}

model Goal {
  id        Int       @id @default(autoincrement())
  text      String
  patientId Int
  createdAt DateTime  @default(now())
  patient   Patient   @relation(fields: [patientId], references: [id])

  @@index([patientId, createdAt])
  @@map("Goal")
}

model Note {
  id        Int       @id @default(autoincrement())
  patientId Int
  text      String
  createdAt DateTime  @default(now())
  patient   Patient   @relation(fields: [patientId], references: [id])

  @@index([patientId, createdAt])
  @@map("Note")
}

model Favorite {
  id         Int       @id @default(autoincrement())
  patientId  Int
  exerciseId Int
  createdAt  DateTime  @default(now())
  patient    Patient   @relation(fields: [patientId], references: [id])
  exercise   Exercice  @relation(fields: [exerciseId], references: [id])

  @@map("Favorite")
}

model Exercice {
  id          Int        @id @default(autoincrement())
  title       String
  description String?
  createdAt   DateTime   @default(now())
  favorites   Favorite[]

  @@map("Exercise")
}

model PendingSignup {
  id           Int       @id @default(autoincrement())
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         String
  tokenHash    String    @map("token_hash")
  expiresAt    DateTime  @map("expires_at")
  consumedAt   DateTime? @map("consumed_at")
  createdAt    DateTime  @default(now()) @map("created_at")

  @@index([tokenHash])
  @@map("PendingSignup")
}

model PendingPasswordReset {
  id         Int       @id @default(autoincrement())
  email      String    @unique
  tokenHash  String    @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  consumedAt DateTime? @map("consumed_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  @@index([tokenHash])
  @@map("PendingPasswordReset")
}
